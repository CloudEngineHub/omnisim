#OMNISIM R2025a utf8

# OmniLink — Deep Robotics M20
# M20 wheeled-legged quadruped (Deep Robotics, BSD-3). Bridge accepts stand / sit / wave / drive forward (real wheel physics) / stop.
# Robot package: projects/robots/deep_robotics/ (PROVENANCE.md explains the
# spawn height, the settle ramp and the newton* stance recipe below).

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — Deep Robotics M20"
  info [
    "M20 wheeled-legged quadruped (Deep Robotics, BSD-3). Bridge accepts stand / sit / wave / drive forward (real wheel physics) / stop"
    "via the omnilink_chat window."
  ]
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
    }
  ]
  # translation_audit: ContactProperties.coulombFriction is an ODE-path field the
  # Newton backend does not read; this declares the same friction where it is read.
  newtonGroundMu 2
  newtonSubsteps 8
  newtonCompoundColliders TRUE
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.624 -4.923 5.626
  follow "m20"
  followType "Tracking Shot"
  followSmoothness 0.3
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage {
  floorSize 6 6
}

DEF M20 URDFRobot {
  url "../../../../robots/deep_robotics/m20/urdf/m20.urdf"
  translation 0 0 0.45
  name "m20"
  supervisor TRUE
  controller "omnilink_quadruped_bridge"
  controllerArgs [ "--robot" "m20" "--port" "8765" ]
  window "omnilink_chat"
}
