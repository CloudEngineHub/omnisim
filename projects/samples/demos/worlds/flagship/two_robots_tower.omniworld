#OMNISIM R2025a utf8
# Two Cartesian robots, real motor joints and friction-only grips. Free dynamic blocks.
# Film lighting: warm neutral surfaces with restrained OmniSim mimosa accents.
EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
WorldInfo { basicTimeStep 8 title "Two robots. Twenty blocks. One tower."
 newtonSolver "mujoco" newtonStatics TRUE newtonRobotColliders TRUE newtonCompoundColliders TRUE
 newtonGroundMu 1.5 newtonCone "elliptic" newtonImpratio 10 newtonCondim 4
 newtonContactKe 2500 newtonContactKd 100 newtonIterations 100 newtonLsIterations 30 }
Viewpoint { position 4.1 -6.8 3.9 orientation -0.1652059852206855 0.09330258284043973 0.9818358368294394 2.128999383709231 fieldOfView .75
 exposure .80 near .05 far 80 ambientOcclusionRadius .5 bloomThreshold 10 }
OmniSimSky { luminosity 1.1 }
DEF SUN OmniSimSun { color 1 .95 .84 intensity 2.6 ambientIntensity .09 castShadows TRUE }
DEF SUN_MARKER OmniSimSunMarker { translation -12 -18 25 }
Floor { size 100 100 tileSize 16 12 appearance PBRAppearance { baseColor .73 .71 .65 metalness 0 roughness .9
 baseColorMap ImageTexture { url ["omnisim://projects/samples/demos/worlds/textures/one_passage/concrete.png"] }
 normalMap ImageTexture { url ["omnisim://projects/appearances/protos/textures/rough_concrete/rough_concrete_normal.jpg"] } normalMapFactor .06 } }
