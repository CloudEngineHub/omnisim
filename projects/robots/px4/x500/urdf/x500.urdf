  <!-- =========================================================
       Camera gimbal: yaw -> pitch -> roll
       ========================================================= -->
  <joint name="camera yaw" type="revolute">
    <parent link="base_link"/>
    <child link="camera_yaw_link"/>
    <origin xyz="0.10 0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7" upper="1.7" effort="5.0" velocity="2.0"/>
  </joint>
  <link name="camera_yaw_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
  </link>

  <joint name="camera pitch" type="revolute">
    <parent link="camera_yaw_link"/>
    <child link="camera_pitch_link"/>
    <origin xyz="0.000625212 -0.00530346 -0.0207448" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="1.7" effort="5.0" velocity="2.0"/>
  </joint>
  <link name="camera_pitch_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
  </link>

  <joint name="camera roll" type="revolute">
    <parent link="camera_pitch_link"/>
    <child link="camera_roll_link"/>
    <origin xyz="0.00754686 0.0160388 -0.00586401" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="5.0" velocity="2.0"/>
  </joint>
  <link name="camera_roll_link">
    <visual>
      <!-- Keep the housing behind the optical origin. With the box centred at
           the sensor origin the Camera renders the inside of its own body. -->
      <origin xyz="-0.020 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.020 0.022"/>
      </geometry>
      <material name="cam_dark">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.00915058 0 -0.000984" rpy="0 0 0"/>
      <mass value="0.0333"/>
      <inertia ixx="1.5e-06" ixy="0" ixz="0" iyy="1.5e-06" iyz="0" izz="1.5e-06"/>
    </inertial>
  </link>

  <!-- Put the optical origin in front of the gimbal housing and airframe.
       A sensor attached at camera_roll_link's origin is physically inside the
       imported robot mesh and renders the housing instead of the scene. -->
  <joint name="camera optical mount" type="fixed">
    <parent link="camera_roll_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-08" ixy="0" ixz="0" iyy="1e-08" iyz="0" izz="1e-08"/>
    </inertial>
  </link>

  <!-- =========================================================
       Sensors (require OMNISIM_URDF_USE_SENSORS=1 to materialise)
       ========================================================= -->
  <gazebo reference="camera_optical_link">
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>0.7854</horizontal_fov>
        <image>
          <width>400</width>
          <height>240</height>
        </image>
      </camera>
      <update_rate>30</update_rate>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="inertial unit" type="imu">
      <update_rate>100</update_rate>
    </sensor>
    <sensor name="gps" type="gps">
      <update_rate>10</update_rate>
    </sensor>
  </gazebo>

</robot>
