<?xml version='1.0' encoding='utf-8'?>
<!--
  OmniTug 500 - OmniSim's generic warehouse tug (AMR with a rear tow pin).

  1.259 m long, 0.716 m wide, deck top 0.296 m, wheel contact plane at z = 0.
  FORWARD IS LOCAL +Y: the bridge (_mobile_configs OMNITUG500,
  forward_yaw_offset -pi/2), the tug's own controllers and every OmniTug world
  drive it along +Y. The tow pin is on the centre line 0.63 m behind the
  centre (rear_offset_m).

  History: until 2026-10-20 this file was a primitive box model laid out along
  +X, a quarter turn from the frame everything drives it in, so every OmniTug
  drove sideways. The visuals are now meshes built by ../meshes/build_meshes.py
  (Blender, original work: no mesh, texture or CAD file from any third party,
  nothing derived from a vendor product model), one OBJ per material.

  VISUAL ONLY, as before: one link, no collision and no inertial geometry; it
  is positioned kinematically by its controller. Add collision geometry here,
  or a boundingObject in the world, if a demo needs it to be solid.

  See ../PROVENANCE.md.
-->
<robot name="omnitug500">

	<material name="omnitug_shell">
		<color rgba="0.898 0.894 0.882 1.0" />
		<omnisim roughness="0.45" metalness="0.0" />
	</material>
	<material name="omnitug_chassis">
		<color rgba="0.129 0.129 0.137 1.0" />
		<omnisim roughness="0.6" metalness="0.1" />
	</material>
	<material name="omnitug_rubber">
		<color rgba="0.045 0.045 0.050 1.0" />
		<omnisim roughness="0.9" metalness="0.0" />
	</material>
	<material name="omnitug_accent">
		<color rgba="0.965 0.780 0.204 1.0" />
		<omnisim roughness="0.5" metalness="0.0" />
	</material>
	<material name="omnitug_light">
		<color rgba="0.400 0.920 1.000 1.0" />
		<omnisim roughness="0.15" metalness="0.0" />
	</material>
	<material name="omnitug_glass">
		<color rgba="0.020 0.030 0.040 1.0" />
		<omnisim roughness="0.08" metalness="0.2" />
	</material>
	<material name="omnitug_steel">
		<color rgba="0.640 0.650 0.670 1.0" />
		<omnisim roughness="0.35" metalness="1.0" />
	</material>
	<material name="omnitug_estop">
		<color rgba="0.780 0.050 0.040 1.0" />
		<omnisim roughness="0.4" metalness="0.0" />
	</material>

	<link name="base_link">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_shell.obj" /></geometry>
			<material name="omnitug_shell" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_chassis.obj" /></geometry>
			<material name="omnitug_chassis" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_rubber.obj" /></geometry>
			<material name="omnitug_rubber" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_accent.obj" /></geometry>
			<material name="omnitug_accent" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_light.obj" /></geometry>
			<material name="omnitug_light" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_glass.obj" /></geometry>
			<material name="omnitug_glass" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_steel.obj" /></geometry>
			<material name="omnitug_steel" />
		</visual>
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry><mesh filename="../meshes/omnitug500_estop.obj" /></geometry>
			<material name="omnitug_estop" />
		</visual>
	</link>

</robot>
