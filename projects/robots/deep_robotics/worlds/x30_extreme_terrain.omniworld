#OMNISIM R2025a utf8

# Deep Robotics X30 -- extreme terrain.
#
# X30 crawls a 16 m obstacle course on real contact physics: 6-14 cm rolling hills, a rubble field of random 2-4 cm plateaus, a 12-degree ramp up to a 0.64 m plateau and down again. Terrain-aware scripted creep gait: feet and body follow the world's height map, swings clear the highest ground on their path. No supervisor pin, no policy.
# Controller: controllers/deep_robotics_crawl (TerrainCrawl in its docstring
# says exactly what it does and does not do: the ElevationGrid is read through
# the Supervisor as the elevation map a real robot would build; nothing senses
# contact). Course: x 0-4 m hills, 4-8 m rubble, 8-11 m ramp up, 11-12 m
# plateau, 12-15 m ramp down; the robot starts 1.5 m before it and stops at
# x = 16.5 m. Stance recipe from PROVENANCE.md.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 8
  title "Deep Robotics X30 -- extreme terrain"
  info [
    "X30 crawls a 16 m obstacle course on real contact physics: 6-14 cm rolling hills, a rubble field of random 2-4 cm plateaus, a 12-degree ramp up to a 0.64 m plateau and down again. Terrain-aware scripted creep gait: feet and body follow the world's height map, swings clear the highest ground on their path. No supervisor pin, no policy."
    "Package: projects/robots/deep_robotics/ (BSD-3-Clause, DeepRoboticsLab)."
  ]
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
    }
  ]
  newtonGroundMu 2
  newtonSubsteps 8
  newtonCompoundColliders TRUE
}
Viewpoint {
  orientation -0.140674 0.324707 0.935295 0.867559
  position -2.4 -3.2 1.6
  follow "x30"
  followType "Tracking Shot"
  followSmoothness 0.4
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

DEF FLOOR Solid {
  translation 12 0 -0.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.24 0.25 0.27
        roughness 0.85
        metalness 0
      }
      geometry Box {
        size 44 12 1.0
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 44 12 1.0
  }
}

