#OMNISIM R2025a utf8

# Hydra vs Gravedigger — flipper vs bar-spinner tribute matchup.
#
# HYDRA       (Hydra tribute)      pneumatic-style front flipper arm
# GRAVEDIGGER (Tombstone tribute)  horizontal bar spinner
#
# Real-bot inspiration: the famous Hydra vs Tombstone matches. Hydra
# has no spinning weapon (nothing to break), it's just a heavy armored
# bot with a front lifting arm that fires up with massive impulse from
# a compressed-CO2 tank. Tombstone has the bar.
#
# Spec sheet (publicly-known approximations; re-derived 2026-09-09 for the
# realism pass -- see the WorldInfo comments for the contact model):
#
#   Hydra (flipper)
#     mass            108 kg total (92 chassis + 8 arm + 4 x 2 wheels)
#     wheel base       0.85 x 0.55 x 0.22 m
#     drive            4 x 40 N.m, 45 rad/s on 0.10 m wheels = 4.5 m/s top speed
#     flipper arm     0.45 m long, 8 kg, hinge axis lateral, anchor
#                     at front-bottom of chassis
#     arm travel       -0.1 to +1.4 rad (~85 deg sweep upward)
#     ram              2500 N.m stall, 55 rad/s no-load: 8.3 kN at the 0.3 m
#                     mid-plate, ~7 g on a 113 kg opponent over the stroke,
#                     which is what throws a heavyweight 2-3 m -- Hydra's
#                     signature. (The old 1000 N.m threw 0.7 m.)
#
#   Gravedigger (bar spinner)
#     mass            113 kg total (75 chassis + 30 bar + 4 x 2 wheels),
#                     the heavyweight limit
#     bar              1.00 x 0.06 x 0.04 m, 30 kg, I = 2.5 kg m^2
#     bar speed        160 rad/s (1530 rpm), tip 80 m/s, stored 32 kJ
#                     (real Tombstone: ~230 rad/s, ~60 kJ; halved so the tip
#                     travels < 3 cm per solver sub-step)
#     bar motor        150 N.m: spin-up from rest in ~2.7 s, so a big hit
#                     costs it seconds of RPM, exactly like the real bar

EXTERNPROTO "omnisim://projects/robot_combat/battlebots/protos/BattleBox.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 4
  title "Hydra vs Gravedigger — Flipper vs Bar Spinner"
  # Newton combat config. MuJoCo solver REQUIRED -- the default XPBD solver structurally
  # cannot drive a multi-wheel rover (lateral left/right wheel pairs lock; proven in pure
  # Python via scripts/dev/wheel_model_diff.py). MuJoCo + ODE drive them; MuJoCo also gives
  # the robust frictional contact combat ramming needs.
  newtonSolver "mujoco"
  # Register arena walls as collision surfaces, else bots drive through them:
  newtonStatics TRUE
  # Give each bot's chassis Box a real collider so ramming registers chassis contacts
  # (without it a Robot wrapper gets a 1 mm placeholder and bots phase through each other):
  newtonRobotColliders TRUE
  # Friction. contactProperties/coulombFriction is NOT read on Newton (the engine warned
  # on every load and ran at mu 1.0); this is the field that sets it. Rubber on steel plate.
  newtonGroundMu 0.9
  # CONTACT HARDNESS (the realism pass, 2026-09-09). Newton maps (ke, kd) onto MuJoCo's
  # contact solref as timeconst = 2/kd and dampratio = kd/(2*sqrt(ke)); the engine defaults
  # 2500/100 reproduce MuJoCo stock (20 ms, critically damped). A 20 ms contact is a
  # cushion: measured on this world it let the bar sink 66 mm into a chassis and
  # swallowed ~98% of the spin energy a hit gave up. 667/111000 is a 3 ms contact, still
  # critically damped (raising ke ALONE drops the damping ratio and parts bounce off --
  # the trap docs/guide/friction-grasp.md fell into). MuJoCo needs timeconst >= 2 sub-steps.
  newtonContactKe 111000
  newtonContactKd 667
  # 12 sub-steps = 0.33 ms: the 80 m/s bar tip moves < 3 cm per sub-step, and the 3 ms
  # contact above stays > 2 sub-steps. (4 sub-steps was 1 ms; the old bar tip moved 5 cm.)
  newtonSubsteps 12
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 14
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

BattleBox {
  enableKillsaw TRUE
  enablePushers TRUE
  enableScrews TRUE
}

# ===========================================================================
# HYDRA — pneumatic-style flipper. Spawns at +X facing west.
# ===========================================================================
DEF HYDRA Robot {
  translation 3.0 0 0.30
  rotation 0 0 1 3.14159265
  name "hydra"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "gravedigger" "--strategy" "aggressor" "--weapon-mode" "pulse" "--pulse-range" "1.2" "--tune" "charge_speed=40" "--tune" "seek_speed=24" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    # ---------------- Hydra-style chassis visuals ----------------
    # Real Hydra is dark navy with yellow accents and a low aggressive
    # profile. Composed from several primitives.
    #
    # Main body — dark navy box.
    Shape {
      appearance PBRAppearance { baseColor 0.05 0.10 0.30 metalness 0 roughness 1 }
      geometry Box { size 0.78 0.50 0.18 }
    }
    # Top deck — lighter navy panel.
    Transform {
      translation 0 0 0.10
      children [ Shape {
        appearance PBRAppearance { baseColor 0.10 0.18 0.45 metalness 0 roughness 1 }
        geometry Box { size 0.55 0.42 0.02 }
      } ]
    }
    # Yellow stripe down centerline (Hydra's signature accent).
    Transform {
      translation 0 0 0.11
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.82 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.55 0.06 0.005 }
      } ]
    }
    # Yellow side accent strips.
    Transform {
      translation 0 0.255 0.02
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.82 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.70 0.01 0.04 }
      } ]
    }
    Transform {
      translation 0 -0.255 0.02
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.82 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.70 0.01 0.04 }
      } ]
    }
    # Side wheel housings.
    Transform {
      translation 0.30 0.27 -0.04
      children [ Shape {
        appearance PBRAppearance { baseColor 0.12 0.12 0.14 metalness 0 roughness 1 }
        geometry Box { size 0.20 0.04 0.16 }
      } ]
    }
    Transform {
      translation 0.30 -0.27 -0.04
      children [ Shape {
        appearance PBRAppearance { baseColor 0.12 0.12 0.14 metalness 0 roughness 1 }
        geometry Box { size 0.20 0.04 0.16 }
      } ]
    }
    Transform {
      translation -0.30 0.27 -0.04
      children [ Shape {
        appearance PBRAppearance { baseColor 0.12 0.12 0.14 metalness 0 roughness 1 }
        geometry Box { size 0.20 0.04 0.16 }
      } ]
    }
    Transform {
      translation -0.30 -0.27 -0.04
      children [ Shape {
        appearance PBRAppearance { baseColor 0.12 0.12 0.14 metalness 0 roughness 1 }
        geometry Box { size 0.20 0.04 0.16 }
      } ]
    }
    # ---------------- 4 wheels ----------------
    DEF HYDRA_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.30 0.30 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF HYDRA_FL_WHEEL Solid {
        translation 0.30 0.30 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF HYDRA_FR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.30 -0.30 -0.05 }
      device [
        RotationalMotor { name "front_right_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "front_right_wheel_sensor" }
      ]
      endPoint DEF HYDRA_FR_WHEEL Solid {
        translation 0.30 -0.30 -0.05
        rotation 1 0 0 1.5708
        name "front_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF HYDRA_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.30 0.30 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint DEF HYDRA_RL_WHEEL Solid {
        translation -0.30 0.30 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF HYDRA_RR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.30 -0.30 -0.05 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint DEF HYDRA_RR_WHEEL Solid {
        translation -0.30 -0.30 -0.05
        rotation 1 0 0 1.5708
        name "rear_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    # ---------------- Pneumatic-style flipper arm ----------------
    # Arm anchored at front-bottom of chassis. Rotates about lateral
    # (Y) axis from -0.1 rad (down, parked) to +1.4 rad (up, fired,
    # ~80 degrees from horizontal).
    #
    # Motor is wildly over-spec compared to an electric motor —
    # maxTorque 2500 N.m and maxVelocity 55 rad/s — because it
    # approximates a CO2-driven pneumatic ram that delivers all of its
    # impulse in ~50 ms. With arm inertia I = (1/3) m L^2 = 0.54 kg m^2
    # the unloaded arm completes its 1.5 rad sweep in ~30 ms; loaded with
    # a 113 kg opponent on the plate it pushes ~8 kN, the figure that
    # throws a heavyweight 2-3 m. (1000 N.m measured a 0.7 m throw.)
    DEF HYDRA_WEAPON_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.30 0 -0.06
        minStop -0.1
        maxStop 1.4
      }
      device [
        RotationalMotor { name "weapon_motor" maxVelocity 55 maxTorque 2500 }
        PositionSensor { name "weapon_sensor" }
      ]
      endPoint DEF HYDRA_WEAPON Solid {
        translation 0.30 0 -0.06
        name "weapon_flipper_arm"
        children [
          # The arm — yellow scoop blade sticking forward.
          Transform {
            translation 0.22 0 0
            children [ Shape {
              appearance PBRAppearance { baseColor 1.0 0.82 0.05 metalness 0 roughness 1 }
              geometry Box { size 0.45 0.40 0.04 }
            } ]
          }
          # Yellow lift-tip at the leading edge.
          Transform {
            translation 0.42 0 -0.005
            children [ Shape {
              appearance PBRAppearance { baseColor 0.90 0.65 0.05 metalness 0 roughness 1 }
              geometry Box { size 0.05 0.40 0.06 }
            } ]
          }
        ]
        boundingObject Transform {
          translation 0.22 0 0
          children [ Box { size 0.45 0.40 0.04 } ]
        }
        physics Physics { density -1 mass 8.0 }
      }
    }
  ]
  boundingObject Box { size 0.78 0.50 0.18 }
  physics Physics { density -1 mass 92.0 }
}

# ===========================================================================
# GRAVEDIGGER  —  horizontal bar spinner (Tombstone tribute)
#   Same bot as in gravedigger_vs_biteforce.omniworld.
# ===========================================================================
DEF GRAVEDIGGER Robot {
  translation -3.0 0 0.35
  rotation 0 0 1 0
  name "gravedigger"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "hydra" "--strategy" "aggressor" "--tune" "charge_speed=40" "--tune" "seek_speed=24" "--tune" "weapon_hold=1.0" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.06 0.06 0.08 metalness 0 roughness 1 }
      geometry Box { size 0.82 0.54 0.13 }
    }
    Transform {
      translation 0 0 0.08
      children [ Shape {
        appearance PBRAppearance { baseColor 0.12 0.12 0.14 metalness 0 roughness 1 }
        geometry Box { size 0.55 0.45 0.02 }
      } ]
    }
    Transform {
      translation 0.38 0.20 -0.02
      rotation 0 0 1 0.49
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.80 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.22 0.10 0.06 }
      } ]
    }
    Transform {
      translation 0.38 -0.20 -0.02
      rotation 0 0 1 -0.49
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.80 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.22 0.10 0.06 }
      } ]
    }
    Transform {
      translation 0 0.275 0
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.80 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.78 0.01 0.06 }
      } ]
    }
    Transform {
      translation 0 -0.275 0
      children [ Shape {
        appearance PBRAppearance { baseColor 1.0 0.80 0.05 metalness 0 roughness 1 }
        geometry Box { size 0.78 0.01 0.06 }
      } ]
    }
    Transform {
      translation 0.35 0.30 -0.05
      children [ Shape {
        appearance PBRAppearance { baseColor 0.20 0.20 0.20 metalness 0 roughness 1 }
        geometry Box { size 0.22 0.04 0.18 }
      } ]
    }
    Transform {
      translation 0.35 -0.30 -0.05
      children [ Shape {
        appearance PBRAppearance { baseColor 0.20 0.20 0.20 metalness 0 roughness 1 }
        geometry Box { size 0.22 0.04 0.18 }
      } ]
    }
    Transform {
      translation -0.35 0.30 -0.05
      children [ Shape {
        appearance PBRAppearance { baseColor 0.20 0.20 0.20 metalness 0 roughness 1 }
        geometry Box { size 0.22 0.04 0.18 }
      } ]
    }
    Transform {
      translation -0.35 -0.30 -0.05
      children [ Shape {
        appearance PBRAppearance { baseColor 0.20 0.20 0.20 metalness 0 roughness 1 }
        geometry Box { size 0.22 0.04 0.18 }
      } ]
    }
    DEF GRAVEDIGGER_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.35 0.32 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF GRAVEDIGGER_FL_WHEEL Solid {
        translation 0.35 0.32 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF GRAVEDIGGER_FR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.35 -0.32 -0.05 }
      device [
        RotationalMotor { name "front_right_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "front_right_wheel_sensor" }
      ]
      endPoint DEF GRAVEDIGGER_FR_WHEEL Solid {
        translation 0.35 -0.32 -0.05
        rotation 1 0 0 1.5708
        name "front_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF GRAVEDIGGER_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.35 0.32 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint DEF GRAVEDIGGER_RL_WHEEL Solid {
        translation -0.35 0.32 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF GRAVEDIGGER_RR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.35 -0.32 -0.05 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 45 maxTorque 40 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint DEF GRAVEDIGGER_RR_WHEEL Solid {
        translation -0.35 -0.32 -0.05
        rotation 1 0 0 1.5708
