              geometry Cylinder { height 0.06 radius 0.09 }
            } ]
          }
          Transform {
            translation 0 0 0.001
            children [ Shape {
              appearance PBRAppearance { baseColor 0.12 0.12 0.14 metalness 0 roughness 1 }
              geometry Cylinder { height 0.062 radius 0.04 }
            } ]
          }
          Transform {
            translation 0.46 0 0
            children [ Shape {
              appearance PBRAppearance { baseColor 0.95 0.20 0.05 metalness 0 roughness 1 }
              geometry Box { size 0.10 0.08 0.06 }
            } ]
          }
          Transform {
            translation -0.46 0 0
            children [ Shape {
              appearance PBRAppearance { baseColor 0.95 0.20 0.05 metalness 0 roughness 1 }
              geometry Box { size 0.10 0.08 0.06 }
            } ]
          }
        ]
        boundingObject Box { size 1.00 0.06 0.04 }
        physics Physics { density -1 mass 30.0 }
      }
    }
  ]
  boundingObject Box { size 0.90 0.60 0.15 }
  physics Physics { density -1 mass 75.0 }
}

DEF DIRECTOR Robot {
  name "damage_director"
  translation 0 0 8
  controller "battlebot_damage_director"
  customData "{\"fighters\": [\"hydra\", \"gravedigger\"], \"arena_size\": 8.0, \"fail_wheels\": 3, \"contact_gate_m\": 1.6, \"timer_s\": 240.0, \"output\": \"_scratch/hydra_vs_gravedigger.json\", \"hp\": {\"chassis\": 250.0, \"wheel\": 14.0, \"weapon\": 35.0}, \"impulse_threshold_J\": {\"chassis\": 35.0, \"wheel\": 0.8, \"weapon\": 8.0}}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}

DEF TRACKER Robot {
  name "duel_tracker"
  translation 0 0 7
  controller "duel_tracker"
  customData "{\"fighters\": [\"HYDRA\", \"GRAVEDIGGER\"]}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}
