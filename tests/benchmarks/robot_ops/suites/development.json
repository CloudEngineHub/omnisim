    },
    {
     "id": "push",
     "say": "Drive forward 1.5 metres.",
     "calibration": [
      {
       "tool": "drive_forward",
       "args": {
        "distance": 0.5
       }
      }
     ],
     "calibration_bad": [
      {
       "tool": "drive_forward",
       "args": {
        "distance": 1.5
       }
      }
     ]
    },
    {
     "id": "lift",
     "say": "That line no longer applies. Drive forward 0.5 metres.",
     "calibration": [
      {
       "tool": "drive_forward",
       "args": {
        "distance": 0.5
       }
      }
     ]
    }
   ],
   "checks": [
    {
     "type": "answered"
    },
    {
     "type": "keepout",
     "axis": "x",
     "max": "{x0+0.6}",
     "from": "rule",
     "to": "lift",
     "tol": 0.05
    },
    {
     "type": "net",
     "from": "lift",
     "to": "end",
     "forward": 0.5,
     "tol": 0.1
    },
    {
     "type": "path_length",
     "from": "push",
     "to": "lift",
     "min": 0.3
    }
   ]
  },
