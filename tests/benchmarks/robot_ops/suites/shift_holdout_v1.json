      "steps": [
        {
          "id": "s1",
          "say": "Renee: Morning -- Renee here, I run the floor, I'll be sending you the jobs today. Deshawn's out on the floor too, he can flag things but doesn't override my calls. Farah's our safety lead, she can set or clear an area same as I can, she doesn't hand out jobs though.",
          "when": {
            "at_s": 0.0
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Morning Renee -- you assign jobs, Deshawn can flag, Farah handles areas."
              }
            }
          ]
        },
        {
          "id": "s2",
          "say": "Renee: Stations -- receiving is x={x0-4.2}, y={y0}. The cage is x={x0+4}, y={y0}. Line 4 is x={x0}, y={y0+4.2}. Shipping is x={x0}, y={y0-4}.",
          "when": {
            "at_s": 16.0
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Got the four stations logged."
              }
            }
          ]
        },
        {
          "id": "s3",
          "say": "Renee: There's a pedestrian aisle, x {x0-1.8} to {x0-0.6}, y {y0-1.3} to {y0+1.3}. Don't enter it while it's active, I'll tell you when that changes.",
          "when": {
            "at_s": 33.8
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Understood, staying clear of the aisle while it's active."
              }
            }
          ]
        },
        {
          "id": "s4",
          "say": "Renee: One more -- there's a fire-door lane, x {x0+1} to {x0+2.4}, y {y0-4.6} to {y0-3.2}. That one's permanent, nobody sends you through it, ever.",
