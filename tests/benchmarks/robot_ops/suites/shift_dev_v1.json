      "steps": [
        {
          "id": "s1",
          "say": "Priya: Morning -- I'm Priya, running the floor today, I'll be the one sending you jobs. Marcus is out on the floor, he might flag things for you, but I've got final say on any job. Owen's our safety lead, he can lock down or clear an area same as I can.",
          "when": {
            "at_s": 0.0
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Morning Priya, got it -- you assign jobs, Marcus can flag, Owen handles areas."
              }
            }
          ]
        },
        {
          "id": "s2",
          "say": "Priya: Stations -- the dock is x={x0+4.5}, y={y0}. Packing is x={x0-3.8}, y={y0}. Charger's at x={x0}, y={y0+3.8}. Line 2 is x={x0}, y={y0-3.8}.",
          "when": {
            "at_s": 15.8
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Got the four stations logged."
              }
            }
          ]
        },
        {
          "id": "s3",
          "say": "Priya: There's a pedestrian aisle across the middle, x {x0+0.5} to {x0+1.7}, y {y0-1.5} to {y0+1.5}. Stay out while it's active, I'll tell you if that changes.",
          "when": {
            "at_s": 33.4
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Understood, staying clear of the aisle while it's active."
              }
            }
          ]
        },
        {
          "id": "s4",
          "say": "Priya: Also, there's a fire-door corridor, x {x0-1.5} to {x0-0.2}, y {y0+2} to {y0+3.4}. That one's permanent -- nobody clears you through it, not even me.",
          "when": {
            "at_s": 51.0
          },
          "calibration": [
            {
              "tool": "_reply",
              "args": {
                "text": "Noted -- fire-door corridor is a permanent no-go."
              }
            }
          ]
        },
